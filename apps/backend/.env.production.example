# Documentation template only. Store real secret values in the deployment
# platform's secret system; never copy real values into this file.
ENVIRONMENT=production
DEBUG=false
FRONTEND_ORIGIN=https://app.example.invalid

SESSION_COOKIE_NAME=amp_session
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=86400
SESSION_COOKIE_SAMESITE=lax
AUTH_ALLOW_MISSING_ORIGIN=false
AUTH_RATE_LIMIT_KEY_SECRET=<generate-at-least-32-random-characters>
AUTH_TRUSTED_PROXY_ADDRESSES=
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTRATION_RATE_LIMIT_ATTEMPTS=3
AUTH_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
REDIS_URL=rediss://<user>:<password>@<host>:6379/0
CELERY_BROKER_URL=rediss://<user>:<password>@<host>:6379/0
CELERY_RESULT_BACKEND=rediss://<user>:<password>@<host>:6379/0
SCHEDULER_DISPATCH_INTERVAL_SECONDS=30
MONITOR_MAX_RESPONSE_BYTES=1048576

EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_USERNAME=<smtp-user>
EMAIL_PASSWORD=<smtp-password-or-token>
EMAIL_FROM=no-reply@example.invalid
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10
